APP_NAME=CubeShop
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# 前台站点域名（CMS-202）：sitemap.xml 里的 URL 指向前台而非 API 站点
CMS_SITE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Shanghai

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- 数据库（PostgreSQL 14+）----
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cubeshop
DB_USERNAME=cubeshop
DB_PASSWORD=cubeshop_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# SEC-06：Token 有效期（单位=分钟，不是秒）。默认 10080 = 7 天；前端完成无感续期后可降至 720（12h）
SANCTUM_TOKEN_EXPIRATION=10080

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=cubeshop

# ---- Redis（可选，缺省时缓存/队列降级为 database 驱动）----
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS="hello@cubeshop.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# 物流轨迹查询渠道（V1.1 T-045）：留空=降级跳过；mock=本地演示；kuaidi100=快递100
SHIPPING_CHANNEL=
# 快递100：授权 key 与查询公司编号（企业管理后台获取）
SHIPPING_CHANNEL_KEY=
SHIPPING_CHANNEL_CUSTOMER=
# 接口地址（一般无需改动）
SHIPPING_QUERY_URL=https://poll.kuaidi100.com/poll/query.do
SHIPPING_AUTONUMBER_URL=https://www.kuaidi100.com/autonumber/auto
# 智能单号识别：随查询套餐赠送；识别失败一律降级，不影响发货
SHIPPING_AUTONUMBER_ENABLED=true
# 批量导入时最多识别多少行（超出跳过，避免大文件拖慢）
SHIPPING_AUTONUMBER_BATCH_LIMIT=100
SHIPPING_TIMEOUT=8
SHIPPING_PULL_WINDOW_DAYS=30
SHIPPING_BATCH_SIZE=50
SHIPPING_BATCH_DELAY_MS=200
SHIPPING_MAX_FAILURES=5
# ⚠️ 拉取间隔固定 30 分钟（routes/console.php）：快递100 要求每单查询间隔 ≥30 分钟，
#    更频繁会触发锁单。请勿调高调度频率。

# ---------- 支付（config/payments.php） ----------
# 沙箱模拟：仅 local/testing/staging 有效，生产必须为 false（SEC-01，误开 = 0 元购漏洞）
PAYMENT_SANDBOX=true
# 回调验签密钥（SEC-02）：无默认值，必须显式配置强随机串。
#   生成：php -r "echo bin2hex(random_bytes(32));"
PAY_SIGN_SECRET=
# 回调来源 IP 白名单（SEC-11，逗号分隔，支持 CIDR，如 10.0.0.0/8,140.207.0.0/16）
# 仅对真实网关（微信/支付宝）生效，沙箱忽略；留空=不限制（依赖签名+nonce 兜底）
PAYMENT_CALLBACK_ALLOWED_IPS=

# ---------- WMS（config/wms.php，菜鸟奇门仓配） ----------
# 网关地址：无默认值，必须显式配置（缺失 = 调用时 fail-closed 抛错，不静默 Mock）
WMS_CAINIAO_GATEWAY_PROD=
WMS_CAINIAO_GATEWAY_SANDBOX=
# 调用超时（秒）
WMS_CAINIAO_TIMEOUT=15
WMS_CAINIAO_CONNECT_TIMEOUT=5
# 协议版本 / 签名方式（以官方最新文档为准；改版只调这里）
WMS_CAINIAO_VERSION=2.0
WMS_CAINIAO_SIGN_METHOD=md5
WMS_CAINIAO_SIGN_SECRET_WRAP=both
# 平台来源标识（奇门 sourcePlatformCode；留空则由适配器按默认取 OTHER）
WMS_CAINIAO_SOURCE_PLATFORM_CODE=
# 可重试错误码白名单（逗号分隔）；奇门 S0x 为厂商私有，联调时按实际报文增补，不改代码
WMS_CAINIAO_RETRYABLE_CODES=
# ⚠️ AppKey / AppSecret / ownerCode / warehouseCode 不在此处配置：
#    在后台「仓库与物流 → WMS 对接」逐仓维护，AppSecret 加密存 wms_configs.app_secret_enc

# ---------- 站内搜索（config/services.php search） ----------
# 检索引擎（留空=自动：PG 可用则用，否则降级 LIKE）
# SEARCH_ENGINE=postgres
# 品牌名/分类名参与检索（影响索引内容，改动后需 search:reindex）
# SEARCH_INDEX_TAXONOMY_NAMES=true
# 联想接口防刷：同 IP 每分钟最大请求数（/api/search/suggest）
SEARCH_SUGGEST_RATE_LIMIT=30

# ---------- 短信渠道（config/services.php sms） ----------
# ⚠️ 凭证（AccessKey ID / Secret）**不在这里配**：它们以密文存在 sms_configs 表，
#    在后台「系统 → 短信渠道」页面维护（接口只回掩码）。
# 服务商 HTTP 超时（秒）
# SMS_TIMEOUT=5
# 发送限流：同 IP 每分钟最大发送次数（短信按条计费，不限流等于开个可刷的账单）
SMS_SEND_RATE_LIMIT=5

# ---------- 认证限流（config/services.php auth） ----------
# 全部只走 config()，config 缓存后是纯数组取用，不查库也不查缓存，不影响请求耗时。
# 认证组兜底：同 IP 每分钟请求数（只防洪水；防暴破看下面按账号维度的两项）
AUTH_RATE_LIMIT=10
# 图形验证码图片：点一下刷新一次的高频轻接口，放宽到每分钟 60 次
CAPTCHA_RATE_LIMIT=60
# 登录：同 IP + 账号 每分钟次数（防暴破，短信登录按手机号计）
LOGIN_RATE_LIMIT=5
# 注册：同 IP 每分钟次数（叠在服务层「同 IP 每日注册上限」之上）
REGISTER_RATE_LIMIT=5
