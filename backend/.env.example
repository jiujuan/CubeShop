APP_NAME=CubeShop
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Shanghai

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- 数据库（PostgreSQL 14+）----
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cubeshop
DB_USERNAME=cubeshop
DB_PASSWORD=cubeshop_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# SEC-06：Token 有效期（单位=分钟，不是秒）。默认 10080 = 7 天；前端完成无感续期后可降至 720（12h）
SANCTUM_TOKEN_EXPIRATION=10080

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=cubeshop

# ---- Redis（可选，缺省时缓存/队列降级为 database 驱动）----
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS="hello@cubeshop.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# 物流轨迹查询渠道（V1.1 T-045）：留空=降级跳过；mock=本地演示；真实渠道账号就绪后切换
SHIPPING_CHANNEL=
SHIPPING_CHANNEL_KEY=
SHIPPING_CHANNEL_CUSTOMER=
SHIPPING_PULL_WINDOW_DAYS=30
SHIPPING_BATCH_SIZE=50
SHIPPING_BATCH_DELAY_MS=200
SHIPPING_MAX_FAILURES=5

# ---------- 支付（config/payments.php） ----------
# 沙箱模拟：仅 local/testing/staging 有效，生产必须为 false（SEC-01，误开 = 0 元购漏洞）
PAYMENT_SANDBOX=true
# 回调验签密钥（SEC-02）：无默认值，必须显式配置强随机串。
#   生成：php -r "echo bin2hex(random_bytes(32));"
PAY_SIGN_SECRET=
# 回调来源 IP 白名单（SEC-11，逗号分隔，支持 CIDR，如 10.0.0.0/8,140.207.0.0/16）
# 仅对真实网关（微信/支付宝）生效，沙箱忽略；留空=不限制（依赖签名+nonce 兜底）
PAYMENT_CALLBACK_ALLOWED_IPS=
