APP_NAME=CubeShop
APP_ENV=production
# 生成方式：php artisan key:generate --show（切勿使用开发环境密钥）
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.cubeshop.example.com
APP_TIMEZONE=Asia/Shanghai
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_FAKER_LOCALE=zh_CN
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
# 日志保留天数（daily 通道）
LOG_DAILY_DAYS=14

# PostgreSQL（生产环境必须修改默认密码）
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cubeshop
DB_USERNAME=cubeshop
DB_PASSWORD=请修改为强密码

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# 队列与缓存：有 Redis 时改为 redis，无 Redis 保持 database 降级运行
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=cubeshop

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

VITE_APP_NAME="${APP_NAME}"

# ---------- 认证 / 安全 ----------
# Token 有效期（分钟）：10080 = 7 天；留空 = 永不过期（不推荐生产使用）
SANCTUM_TOKEN_EXPIRATION=10080
# 生产环境必须设置为前端实际域名（逗号分隔），禁止 *
CORS_ALLOWED_ORIGINS=https://www.cubeshop.example.com,https://admin.cubeshop.example.com

# ---------- 支付（config/payments.php） ----------
# true = 沙箱模拟（默认，仅用于联调）；false = 正式渠道（需接入微信/支付宝后替换实现）
PAYMENT_SANDBOX=true
# 回调验签密钥：生产必须为强随机串（php -r "echo bin2hex(random_bytes(32));"）
PAY_SIGN_SECRET=请替换为32字节以上随机密钥

# ---------- 运营参数说明 ----------
# 订单超时分钟数、默认运费、包邮阈值、库存预警阈值均存于数据库 system_configs 表，
# 通过管理端「系统配置」页在线调整（无需改 .env）；初始值由 OrderConfigSeeder 写入。
